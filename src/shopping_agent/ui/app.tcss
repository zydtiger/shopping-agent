Screen {
    background: #0b1020;
    color: #edf2ff;
}

#shell {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: #0d1324;
    overflow-y: auto;
}

#hero {
    content-align: center middle;
    text-style: bold;
    color: #f5d76e;
    padding: 1 0 0 0;
}

#subhero {
    color: #b8c3e0;
    padding: 0 0 1 0;
}

#design-status {
    color: #9ed8c2;
    padding-bottom: 1;
}

.section-label {
    text-style: bold;
    color: #f2c87c;
    padding-top: 1;
}

#query-input {
    margin: 0 0 1 0;
}

#search-row {
    height: auto;
    align: left middle;
}

#loading {
    margin-left: 1;
    color: #f2c87c;
}

#status-copy {
    min-height: 2;
    color: #d9e3ff;
    padding: 1 0;
}

#clarification-panel,
#results-panel,
#log-panel {
    height: auto;
}

.question-card,
.result-card {
    background: #162340;
    border: round #31466f;
    margin: 0 0 1 0;
    padding: 1;
}

.question-prompt {
    text-style: bold;
    color: #edf2ff;
}

.question-reason {
    color: #99aacf;
    padding-bottom: 1;
}

.option-row {
    height: auto;
}

.answer-option {
    margin-right: 1;
    background: #22335a;
}

.answer-option.selected {
    background: #9ed8c2;
    color: #102133;
    text-style: bold;
}

.result-copy {
    color: #edf2ff;
    padding-bottom: 1;
}

.log-line {
    color: #b8c3e0;
}
