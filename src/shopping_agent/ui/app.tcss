Screen {
    background: #09111d;
    color: #edf2ff;
}

#launch-view {
    width: 1fr;
    height: 1fr;
    align: center middle;
    padding: 0 4;
}

#launch-query-input {
    width: 72;
    border: round #3a537f;
    background: #132038;
    color: #edf2ff;
}

#main-view {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

.panel {
    border: round #31466f;
    background: #0f182b;
    padding: 1 2;
}

#search-panel {
    height: auto;
    margin-bottom: 1;
}

#status-panel {
    height: auto;
    margin-bottom: 1;
}

#bottom-panel {
    height: 1fr;
    padding: 0 1;
}

.panel-title {
    text-style: bold;
    color: #f2c87c;
}

#active-prompt {
    color: #edf2ff;
    padding: 0 0 1 0;
}

#design-status {
    color: #9ed8c2;
    padding: 0 0 1 0;
}

#search-row {
    height: auto;
    align: left middle;
}

#active-query-input {
    width: 1fr;
}

#loading {
    width: 3;
    margin-left: 1;
    color: #f2c87c;
}

#status-copy {
    color: #c4d1ef;
    padding-top: 0;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 0 0 0;
}

#recommendations-table {
    height: 1fr;
}

#table-hint {
    color: #9fb2d8;
    padding-top: 1;
}

#logs-view {
    height: 1fr;
    background: #0c1424;
    border: round #20324f;
    color: #dbe7ff;
}

ClarificationDialog {
    align: center middle;
    background: #050a12;
}

#dialog-card {
    width: 76;
    height: auto;
    border: round #3a537f;
    background: #132038;
    padding: 1 2;
}

.dialog-title {
    text-style: bold;
    color: #f2c87c;
    padding-bottom: 1;
}

.dialog-reason {
    color: #b8c3e0;
    padding-bottom: 1;
}

.dialog-options {
    height: auto;
}

.dialog-choice {
    width: 1fr;
    margin-bottom: 1;
    background: #1b2b49;
}

.dialog-label {
    color: #9ed8c2;
    padding-top: 1;
    padding-bottom: 1;
}

#dialog-custom-row {
    height: auto;
}

#dialog-custom-input {
    width: 1fr;
    margin-right: 1;
}
